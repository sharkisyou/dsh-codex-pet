{
  "name": "@yshark/dsh-codex-pet",
  "version": "0.1.2",
  "description": "DSH 桥接插件：把会话活动翻译成桌宠线协议并推送，并在 DSH 设置页提供极简桌宠入口",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "pet",
    "bridge",
    "desktop-pet",
    "websocket"
  ],
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "PUBLISHING.md"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test",
    "build": "node --check lib/index.mjs && node --check lib/client.js"
  },
  "dependencies": {
    "@yshark/pet-protocol": "0.1.0",
    "ws": "^8.21.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
