{
  "name": "@yshark/pet-protocol",
  "version": "0.1.0",
  "description": "Public WebSocket wire protocol schema, constants, and generated TypeScript types for the DSH desktop pet.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/events.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "scripts"
  ],
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "build": "npm run generate && tsc -p tsconfig.json",
    "typecheck": "npm run generate && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
