{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Pet",
  "version": "0.1.0",
  "identifier": "dev.yshark.desktop-pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Desktop Pet",
        "url": "index.html?window=pet",
        "width": 320,
        "height": 320,
        "minWidth": 160,
        "minHeight": 160,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true
      },
      {
        "label": "settings",
        "title": "桌宠设置",
        "url": "index.html?window=settings",
        "width": 520,
        "height": 640,
        "visible": false,
        "resizable": true
      },
      {
        "label": "tray",
        "title": "活动",
        "url": "index.html?window=tray",
        "width": 300,
        "height": 240,
        "minWidth": 220,
        "minHeight": 80,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
